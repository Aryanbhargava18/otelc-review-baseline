d — a wider blast radius than the PR description discloses. Worth a line in the description calling that out.","state":"COMMENTED","html_url":"https://github.com/open-telemetry/opentelemetry-go-compile-instrumentation/pull/629#pullrequestreview-4625628688","pull_request_url":"https://api.github.com/repos/open-telemetry/opentelemetry-go-compile-instrumentation/pulls/629","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/open-telemetry/opentelemetry-go-compile-instrumentation/pull/629#pullrequestreview-4625628688"},"pull_request":{"href":"https://api.github.com/repos/open-telemetry/opentelemetry-go-compile-instrumentation/pulls/629"}},"submitted_at":"2026-07-03T12:05:17Z","commit_id":"1625e1ba8f6db9c4530dba46a4f8e8a8cc8f95ba"},{"id":4646690263,"node_id":"PRR_kwDONpzSS88AAAABFPbd1w","user":{"login":"kakkoyun","id":536449,"node_id":"MDQ6VXNlcjUzNjQ0OQ==","avatar_url":"https://avatars.githubusercontent.com/u/536449?u=8eebfbf83f3dbc6d4aaa47f90a190d2e543abc4d&v=4","gravatar_id":"","url":"https://api.github.com/users/kakkoyun","html_url":"https://github.com/kakkoyun","followers_url":"https://api.github.com/users/kakkoyun/followers","following_url":"https://api.github.com/users/kakkoyun/following{/other_user}","gists_url":"https://api.github.com/users/kakkoyun/gists{/gist_id}","starred_url":"https://api.github.com/users/kakkoyun/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kakkoyun/subscriptions","organizations_url":"https://api.github.com/users/kakkoyun/orgs","repos_url":"https://api.github.com/users/kakkoyun/repos","events_url":"https://api.github.com/users/kakkoyun/events{/privacy}","received_events_url":"https://api.github.com/users/kakkoyun/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"APPROVED","html_url":"https://github.com/open-telemetry/opentelemetry-go-compile-instrumentation/pull/629#pullrequestreview-4646690263","pull_request_url":"https://api.github.com/repos/