ISSED","html_url":"https://github.com/open-telemetry/opentelemetry-go-compile-instrumentation/pull/806#pullrequestreview-4858213876","pull_request_url":"https://api.github.com/repos/open-telemetry/opentelemetry-go-compile-instrumentation/pulls/806","author_association":"NONE","_links":{"html":{"href":"https://github.com/open-telemetry/opentelemetry-go-compile-instrumentation/pull/806#pullrequestreview-4858213876"},"pull_request":{"href":"https://api.github.com/repos/open-telemetry/opentelemetry-go-compile-instrumentation/pulls/806"}},"submitted_at":"2026-08-04T19:36:30Z","commit_id":"74915677918968c03d9ced593385578a7119081c"},{"id":4884322448,"node_id":"PRR_kwDONpzSS88AAAABIyDYkA","user":{"login":"amazingakai","id":93782497,"node_id":"U_kgDOBZcB4Q","avatar_url":"https://avatars.githubusercontent.com/u/93782497?u=636eb3c0c0e15f40e91bd088e19b41718b12ddeb&v=4","gravatar_id":"","url":"https://api.github.com/users/amazingakai","html_url":"https://github.com/amazingakai","followers_url":"https://api.github.com/users/amazingakai/followers","following_url":"https://api.github.com/users/amazingakai/following{/other_user}","gists_url":"https://api.github.com/users/amazingakai/gists{/gist_id}","starred_url":"https://api.github.com/users/amazingakai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/amazingakai/subscriptions","organizations_url":"https://api.github.com/users/amazingakai/orgs","repos_url":"https://api.github.com/users/amazingakai/repos","events_url":"https://api.github.com/users/amazingakai/events{/privacy}","received_events_url":"https://api.github.com/users/amazingakai/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/open-telemetry/opentelemetry-go-compile-instrumentation/pull/806#pullrequestreview-4884322448","pull_request_url":"https://api.github.com/repos/open-telemetry/opentelemetry-go-compile-instrumentation/pulls/806","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/open-telemetry/opentelemetry-go-compile-instrumentation/pull/806#pullrequestreview-4884322448"},"pull_request":{"href":"https://api.github.com/repos/open-telemetry/opentelemetry-go-compile-instrumentation/pulls/806"}},"submitted_at":"2026-08-07T15:41:11Z","commit_id":"995a528d3195751532b37f9753c9036ae29bad43"},{"id":4940196620,"node_id":"PRR_kwDONpzSS88AAAABJnVrDA","user":{"login":"darccio","id":163009,"node_id":"MDQ6VXNlcjE2MzAwOQ==","avatar_url":"https://avatars.githubusercontent.com/u/163009?u=87bc97002613bf7ea161e7753f5b91f96a074d36&v=4","gravatar_id":"","url":"https://api.github.com/users/darccio","html_url":"https://github.com/darccio","followers_url":"https://api.github.com/users/darccio/followers","following_url":"https://api.github.com/users/darccio/following{/other_user}","gists_url":"https://api.github.com/users/darccio/gists{/gist_id}","starred_url":"https://api.github.com/users/darccio/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/darccio/subscriptions","organizations_url":"https://api.github.com/users/darccio/orgs","repos_url":"https://api.github.com/users/darccio/repos","events_url":"https://api.github.com/users/darccio/events{/privacy}","received_events_url":"https://api.github.com/users/darccio/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"The PR description doesn't match what was merged. It describes a\nGOVULNCHECK_VERSION variable, a single loop over \"27 shipped modules\", and\na Renovate customManager to keep that variable current — none of these\nexist in the final code. What actually shipped is cleaner: govulncheck is\npinned via .tools/go.mod like every other repo tool (tracked by the\nexisting generic Renovate gomod rule, no dedicated customManager needed),\nand core/instrumentation are two differentiated jobs rather than one\n27-module loop. Please update the PR description to match the implementation\nthat's actually being reviewed/merged.\n\nThe grpc bump (v1.81.1 → v1.82.1) is incomplete. v1.82.1 isn't a routine\nbump — it's the fix release for GO-2026-6061 (xDS RBAC authorization bypass\n+ HTTP/2 transport server DoS in grpc-go, CVSS 8.2/7.5), almost certainly\nthe vulnerability this PR's govulncheck integration was meant to close.\n\nFour modules under test/apps/ were left on v1.82.0, one patch behind, even\nthough every other module (including instrumentation/google.golang.org/grpc/{client,server}\nand test/apps/grpcclient) was correctly bumped to v1.82.1:\n\n- test/apps/grpcserver/go.mod:9\n- test/apps/grpcserverkafkaclient/go.mod:10\n- test/apps/grpcserverdbclient/go.mod:12\n- test/apps/grpcservergrpcclient/go.mod:9\n\nThis isn't theoretical — I ran govulncheck directly against test/apps/grpcserver\nin this state and it reports the vulnerability live, with a concrete call\ntrace through grpc.Server.Serve:\n\n  Vulnerability #2: GO-2026-6061\n    Module: google.golang.org/grpc\n    Found in: google.golang.org/grpc@v1.82.0\n    Fixed in: google.golang.org/grpc@v1.82.1\n    Example traces found:\n      #1: main.go:56:2: grpcserver.main calls net.UnixListener.Close, which\n          eventually calls transport.NewHTTP2Client\n      #2: main.go:62:19: grpcserver.main calls grpc.Server.Serve, which\n          eventually calls transport.NewServerTransport\n\nAll four of these modules are top-level dirs under test/apps/, which means\nthey're in GOVULNCHECK_TEST_APPS and get scanned by the new\ngovulncheck-instrumentation CI job — the one this PR makes hard-blocking.\nAs merged, that job will fail on these apps on the very grpc-server code\npaths the bump was meant to fix.\n\nFix: in each of the four go.mod files above, bump to\n`google.golang.org/grpc v1.82.1` and run `go mod tidy`, matching the rest\nof the PR's bump.\n\n(Also left on older grpc versions but outside the scanned set, so lower\npriority: test/go.mod and test/shared/grpcpb/go.mod on v1.80.0, and\ndemo/app/grpc/{client,server}/go.mod on v1.82.0 — demos are excluded from\nscanning by design per the Makefile comment.)","state":"CHANGES_REQUESTED","html_url":"https://github.com/open-telemetry/opentelemetry-go-compile-instrumentation/pull/806#pullrequestreview-4940196620","pull_request_url":"https://api.github.com/repos/open-telemetry/opentelemetry-go-compile-instrumentation/pulls/806","author_association":"CONTRIBUTOR","_links":{"html":{"href":"https://github.com/open-telemetry/opentelemetry-go-compile-instrumentation/pull/806#pullrequestreview-4940196620"},"pull_request":{"href":"https://api.github.com/repos/open-telemetry/opentelemetry-go-compile-instrumentation/pulls/806"}},"submitted_at":"2026-08-14T19:38:41Z","commit_id":"995a528d3195751532b37f9753c9036ae29bad43"},{"id":4943307918,"node_id":"PRR_kwDONpzSS88AAAABJqTkjg","user":{"login":"atharvamhaske","id":143622968,"node_id":"U_kgDOCI-DOA","avatar_url":"https://avatars.githubusercontent.com/u/143622968?u=4718a7fbcb3f033d79d617fb27a9b7dac5758b06&v=4","gravatar_id":"","url":"https://api.github.com/users/atharvamhaske","html_url":"https://github.com/atharvamhaske","followers_url":"https://api.github.com/users/atharvamhaske/followers","following_url":"https://api.github.com/users/atharvamhaske/following{/other_user}","gists_url":"https://api.github.com/users/atharvamhaske/gists{/gist_id}","starred_url":"https://api.github.com/users/atharvamhaske/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/atharvamhaske/subscriptions","organizations_url":"https://api.github.com/users/atharvamhaske/orgs","repos_url":"https://api.github.com/users/atharvamhaske/repos","events_url":"https://api.github.com/users/atharvamhaske/events{/privacy}","received_events_url":"https://api.github.com/users/atharvamhaske/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/open-telemetry/opentelemetry-go-compile-instrumentation/pull/806#pullrequestreview-49433